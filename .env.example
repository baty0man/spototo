# --- Yoto pixel pipeline ---
YOTO_CLIENT_ID=
# Fallback card for MP3s dropped directly into data/watch/ (not in a Yoto-*
# subfolder). Playlist-driven cards are named after the playlist instead.
YOTO_CARD_TITLE=Kids Playlist
# Optional: card ID for that fallback default card, if one already exists.
YOTO_CARD_ID=

# How each chapter gets its icon:
#   generate     -- LLM subject + AI pixel art, best-of-N judged (default)
#   yoto-library -- deterministic keyword match against Yoto's own official
#                   icon library, no AI at all. No match -> no custom icon.
#   yoto-library-ai -- library first; AI on no-match ONLY with token + positive cap
#   none         -- skip icons entirely
# Token alone never enables paid hybrid fallback.
ICON_SOURCE=generate
REPLICATE_API_TOKEN=
# Hybrid lifetime generation-attempt allowance (NOT dollars); safe default 0.
# Each attempt can include subject extraction, multiple images and a judge.
ICON_AI_MAX_GENERATIONS=0
# Persistent private cache; deleting it also deletes accounting. Keep it backed up.
# ICON_CACHE_DIR=data/icons

# Icon quality vs cost dial (generate and enabled yoto-library-ai fallback): how many candidate
# icons to generate per song before a vision model picks the best. rd-fast is
# ~$0.015/image, and the LLM + judge are negligible, so cost per song is
# roughly ICON_CANDIDATES x $0.015:
#   8 -> ~$0.12/song (best quality)   4 -> ~$0.06   2 -> ~$0.03   1 -> ~$0.015 (no best-of)
# Diminishing returns past ~4; concrete subjects are reliably good even at 4.
ICON_CANDIDATES=8

# Advanced / rarely need to change:
# YOTO_AUTH_BASE=https://login.yotoplay.com
# YOTO_API_BASE=https://api.yotoplay.com
# YOTO_AUDIENCE=https://api.yotoplay.com
# STABLE_WAIT_SECONDS=3
# ICON_JUDGE_MODEL=lucataco/qwen2-vl-7b-instruct:<version>

# --- Spotify sync (multi-playlist) ---
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
# Any Spotify playlist whose name starts with this prefix becomes a Yoto card
# named after the playlist with the prefix stripped (e.g. "Yoto-Bedtime" -> "Bedtime").
SPOTIFY_PLAYLIST_PREFIX=Yoto-
# Redirect URI registered on your Spotify app; used only by spotify_auth_setup.py.
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback
# How often the spotify-sync container polls (seconds). Only used by the
# Docker Compose path (spotify_sync/loop.py) -- if you're running sync.py via
# the systemd timer instead, its interval is set in systemd/spotify-sync.timer.
# SPOTIFY_POLL_SECONDS=300
